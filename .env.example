# Environment Variables Configuration
# RULES:
# 1. Any variable starting with VITE_ is exposed to the browser client bundle.
# 2. NEVER put secrets, private keys, database credentials, or API tokens in VITE_ variables.
# 3. All secrets MUST be stored exclusively on the server and accessed via process.env.

# ==============================================================================
# SERVER-SIDE SECRETS (NEVER exposed to the browser)
# ==============================================================================
DATABASE_URL="postgresql://school_admin:secure_password_replace@localhost:5432/school_sms_db"
JWT_SECRET="generate_a_minimum_64_char_secure_random_hex_string_here"
GEMINI_API_KEY="AI_STUDIO_INJECTED_OR_SERVER_SECRET_KEY"
STRIPE_SECRET_KEY="sk_live_replace_with_server_stripe_secret_key"
STRIPE_WEBHOOK_SECRET="whsec_replace_with_stripe_webhook_signing_secret"
PORT="3000"

# ==============================================================================
# CLIENT-SAFE VARIABLES (Only non-sensitive public configuration)
# ==============================================================================
# Base URL for API requests (relative '/api' recommended for same-origin)
VITE_APP_NAME="Secure School Management System"
VITE_APP_ENV="production"
